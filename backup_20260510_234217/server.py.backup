app = FastAPI(
    title="AIGAANE V4 API",
    description="""
    ## Vedic Sound + Poetry + Astrology Engine
    
    ### Features:
    - **49D Kernel**: Deterministic hashing and entropy calculation
    - **Sandhi**: External sandhi rules (vowel, visarga)
    - **Nakshatra Analysis**: Sound, poetry, and mantra generation
    - **Prosody Validation**: Laghu-Guru meter checking
    - **Anumana Layer**: Predictive state modeling
    """,
    version="4.0.0",
    contact={
        "name": "AIGAANE",
        "url": "https://www.aigaane.in",
    }
)

# CORS for frontend
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# ========== ENUMS FOR BETTER DOCUMENTATION ==========
class SandhiType(str, Enum):
    VOWEL = "vowel"
    VISARGA = "visarga"
    CONSONANT = "consonant"
    AUTO = "auto"

class ProsodyPattern(str, Enum):
    LAGHU = "L"
    GURU = "G"

# ========== 49D KERNEL ==========
class StatsRequest(BaseModel):
    text: str = Field(..., description="Sanskrit text to analyze", example="Rāma")

class StatsResponse(BaseModel):
    sigma_dim: float = Field(..., description="Sum of dimensions (energy measure)")
    entropy: float = Field(..., description="Shannon entropy (information content)")
    hash: str = Field(..., description="8-character hex hash", example="2693315")

def compute_49d(text: str) -> Dict[str, Any]:
    """49-dimensional kernel computation"""
    vec = [0.0] * 49
    for i, ch in enumerate(text):
        code = ord(ch) % 49
        for d in range(49):
            vec[d] += (code / (i + 1)) * math.sin(d * (i + 1))
    
    sigma = sum(abs(v) for v in vec)
    total = sigma if sigma > 0 else 1
    probs = [abs(v) / total for v in vec]
    entropy = -sum(p * math.log(p + 1e-12) for p in probs)
    vec_str = "".join(f"{v:.5f}" for v in vec)
    hash_val = hashlib.sha256(vec_str.encode()).hexdigest()[:8]
    
    return {"sigma_dim": round(sigma, 5), "entropy": round(-entropy, 5), "hash": hash_val}

@app.post(
    "/api/49d/stats",
    response_model=StatsResponse,
    summary="49D Kernel Analysis",
    description="Computes 49-dimensional hash, entropy, and energy from Sanskrit text"
)
async def fortynine_stats(req: StatsRequest):
    """Returns deterministic hash and entropy for any Sanskrit input"""
    return StatsResponse(**compute_49d(req.text))

# ========== SANDHI ENDPOINT (Enhanced) ==========
class SandhiRequest(BaseModel):
    left: str = Field(..., description="Left word/pada", example="devaḥ")
    right: str = Field(..., description="Right word/pada", example="api")
    sandhi_type: SandhiType = Field(default=SandhiType.AUTO, description="Type of sandhi to apply")

class SandhiResponse(BaseModel):
    left: str
    right: str
    result: str
    sandhi_type: str
    rule_applied: str

def apply_vowel_sandhi(left: str, right: str) -> tuple:
    """6.1.77: iko yaṇ aci - vowel sandhi"""
    ik_vowels = set("iīuūṛṝḷ")
    ac_vowels = set("aāiīuūṛṝḷeoaiau")
    
    if left[-1] in ik_vowels and right[0] in ac_vowels:
        mapping = {'i':'y', 'ī':'y', 'u':'v', 'ū':'v', 'ṛ':'r', 'ṝ':'r', 'ḷ':'l'}
        return left[:-1] + mapping.get(left[-1], left[-1]) + right, "6.1.77 (iko yaṇ aci)"
    return left + right, "none"

def apply_visarga_sandhi(left: str, right: str) -> tuple:
    """8.3.15: visarga + vowel → r + vowel"""
    ac_vowels = set("aāiīuūṛṝḷeoaiau")
    if left[-1] == 'ḥ' and right[0] in ac_vowels:
        return left[:-1] + 'r' + right, "8.3.15 (visarga + vowel → r)"
    return left + right, "none"

def apply_sandhi(left: str, right: str, sandhi_type: str) -> tuple:
    """External sandhi with type specification"""
    if sandhi_type == "vowel":
        return apply_vowel_sandhi(left, right)
    elif sandhi_type == "visarga":
        return apply_visarga_sandhi(left, right)
    else:
        # AUTO: try vowel first, then visarga
        result, rule = apply_vowel_sandhi(left, right)
        if rule != "none":
            return result, rule
        return apply_visarga_sandhi(left, right)

@app.post(
    "/api/sandhi",
    response_model=SandhiResponse,
    summary="External Sandhi",
    description="Applies Paninian external sandhi rules between two words"
)
async def external_sandhi(req: SandhiRequest):
    """Returns sandhi-joined result with rule citation"""
    result, rule = apply_sandhi(req.left, req.right, req.sandhi_type)
    return SandhiResponse(
        left=req.left,
        right=req.right,
        result=result,
        sandhi_type=req.sandhi_type,
        rule_applied=rule
    )

# ========== NAKSHATRA ANALYSIS ==========
class NakshatraRequest(BaseModel):
    text: str = Field(..., description="Sanskrit text or name", example="Rāma")
    hash_val: Optional[int] = Field(None, description="Optional precomputed hash")

class NakshatraResponse(BaseModel):
    text: str
    hash: int
    nakshatra: str
    index: int
    pada: Optional[int] = Field(None, description="Nakshatra quarter (1-4)")
    sound: Dict[str, Any]
    creative: Dict[str, Any]
    mantra: str
    frequency_hz: float

def get_hash_from_text(text: str) -> int:
    h = 0
    for char in text:
        h = ((h << 5) - h) + ord(char)
        h = h & 0xffffffff
    return abs(h)

def get_pada_from_hash(hash_val: int) -> int:
    """Calculate pada (1-4) within nakshatra"""
    return (hash_val % 4) + 1

@app.post(
    "/api/nakshatra/analyze",
    response_model=NakshatraResponse,
    summary="Complete Nakshatra Analysis",
    description="Returns sound, poetry, and mantra data for any Sanskrit text"
)
async def analyze_nakshatra(req: NakshatraRequest):
    """Full creative analysis from text input"""
    text = req.text.strip()
    hash_val = req.hash_val if req.hash_val else get_hash_from_text(text)
    
    sound_db = get_sound_db()
    creative_db = get_creative_db()
    
    sound = sound_db.get_by_hash(hash_val)
    creative = creative_db.get_by_hash(hash_val)
    
    if not sound or not creative:
        raise HTTPException(status_code=404, detail="Nakshatra not found")
    
    frequency = sound_db.get_svara_frequency(sound.get("svara", "Sa (śuddha)"))
    mantra = sound_db.generate_mantra_phrase(sound)
    pada = get_pada_from_hash(hash_val)
    
    return NakshatraResponse(
        text=text,
        hash=hash_val,
        nakshatra=creative["name"],
        index=creative["index"],
        pada=pada,
        sound={
            "svara": sound.get("svara"),
            "raga": creative.get("raga", {}).get("primary"),
            "time": creative.get("raga", {}).get("time"),
            "mood": creative.get("raga", {}).get("mood")
        },
        creative={
            "chand": creative.get("chand"),
            "kavita": creative.get("kavita"),
            "lyrics": creative.get("lyrics")
        },
        mantra=mantra,
        frequency_hz=round(frequency, 1)
    )

# ========== NEW: PROSODY VALIDATION ==========
class ProsodyRequest(BaseModel):
    text: str = Field(..., description="Sanskrit verse to scan", example="rāmaḥ rājā")
    expected_pattern: Optional[str] = Field(None, description="Expected L/G pattern", example="LGLGLG")

class ProsodyResponse(BaseModel):
    text: str
    syllables: List[str]
    pattern: str
    is_valid: Optional[bool] = None
    laghu_count: int
    guru_count: int

def is_guru(syllable: str) -> bool:
    long_vowels = set("āīūṝeoai")
    short_vowels = set("aiuṛḷ")
    
    for ch in syllable:
        if ch in long_vowels:
            return True
    for i, ch in enumerate(syllable):
        if ch in short_vowels:
            for j in range(i+1, len(syllable)):
                if syllable[j] in ('ṃ', 'ḥ'):
                    return True
                if j+1 < len(syllable) and syllable[j] not in long_vowels and syllable[j+1] not in long_vowels:
                    return True
            break
    return False

@app.post(
    "/api/prosody/validate",
    response_model=ProsodyResponse,
    summary="Validate Prosody (Laghu-Guru)",
    description="Scans Sanskrit text and returns Laghu (L) / Guru (G) pattern"
)
async def validate_prosody(req: ProsodyRequest):
    """Returns syllable pattern for meter validation"""
    syllables = re.findall(r'[aāiīuūṛṝḷeoaiau][^aāiīuūṛṝḷeoaiau]*', req.text)
    pattern = ''.join(['G' if is_guru(s) else 'L' for s in syllables])
    
    is_valid = None
    if req.expected_pattern:
        is_valid = (pattern == req.expected_pattern)
    
    return ProsodyResponse(
        text=req.text,
        syllables=syllables,
        pattern=pattern,
        is_valid=is_valid,
        laghu_count=pattern.count('L'),
        guru_count=pattern.count('G')
    )

# ========== NEW: DATASET SAMPLE ==========
@app.get(
    "/api/dataset/sample",
    summary="Random Creative Sample",
    description="Returns a random creative seed from the Vedic Sanctuary"
)
async def get_random_sample():
    """Returns random nakshatra creative data as inspiration"""
    creative_db = get_creative_db()
    random_nakshatra = random.choice(creative_db.data['nakshatras'])
    
    return {
        "nakshatra": random_nakshatra['name'],
        "raga": random_nakshatra.get('raga', {}).get('primary'),
        "chand": random_nakshatra.get('chand', {}).get('meter'),
        "rasa": random_nakshatra.get('kavita', {}).get('rasa'),
        "theme": random_nakshatra.get('kavita', {}).get('theme'),
        "seed_word": random.choice(random_nakshatra.get('lyrics', {}).get('seed_words', ['om']))
    }

# ========== NEW: ANUMANA LAYER (Predictive) ==========
class AnumanaRequest(BaseModel):
    current_hash: int = Field(..., description="Current 49D hash")
    steps: int = Field(default=1, ge=1, le=9, description="Steps to predict (1-9)")

class AnumanaResponse(BaseModel):
    current_nakshatra: str
    current_navatara: str
    next_nakshatra: str
    next_navatara: str
    predicted_raga: str
    predicted_mood: str

@app.post(
    "/api/anu-layer/predict",
    response_model=AnumanaResponse,
    summary="Anumana Layer - Predictive State Modeling",
    description="Predicts next Nakshatra and Navatara phase based on current hash"
)
async def predict_next_state(req: AnumanaRequest):
    """Forward prediction for creative guidance"""
    creative_db = get_creative_db()
    
    current_idx = req.current_hash % 27
    next_idx = (current_idx + req.steps) % 27
    
    current_n = creative_db.get_by_hash(req.current_hash)
    next_n = creative_db.get_by_index(next_idx)
    
    # Navatara calculation
    navatara_names = ["Janma", "Sampat", "Vipat", "Kṣema", "Pratyari", 
                      "Sādhana", "Naidhana", "Mitra", "Ati-mitra"]
    current_navatara = navatara_names[(current_idx) % 9]
    next_navatara = navatara_names[(next_idx) % 9]
    
    return AnumanaResponse(
        current_nakshatra=current_n['name'],
        current_navatara=current_navatara,
        next_nakshatra=next_n['name'],
        next_navatara=next_navatara,
        predicted_raga=next_n.get('raga', {}).get('primary', 'Unknown'),
        predicted_mood=next_n.get('kavita', {}).get('tone', 'peaceful')
    )

